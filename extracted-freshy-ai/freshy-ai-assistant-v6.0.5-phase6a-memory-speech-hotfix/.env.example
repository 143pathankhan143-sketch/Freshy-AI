# Copy this file to .env in the project root. Never commit the real .env file.

# Freshy Core
FRESHY_CORE_HOST=127.0.0.1
FRESHY_CORE_PORT=8000
DEBUG=false

# Phase 4 AI router. Known local commands never call these providers.
AI_ENABLED=true
AI_PROVIDER_ORDER=groq,mistral,gemini,sambanova

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# Live search only; Tavily is not used as a chat provider.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=15

AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=1
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_MAX_HISTORY_MESSAGES=16
AI_MAX_HISTORY_CHARACTERS=24000
AI_MAX_INPUT_CHARACTERS=12000
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.3

# Optional hosted web preview URL; never put secrets in VITE_* variables.
APP_URL=

# Freshy Phase 4.3 voice output defaults
# provider: gemini | xtts | system | text_only
TTS_ENABLED=true
TTS_PROVIDER=gemini
TTS_NATURAL_VOICE=hindi_female
TTS_SPEECH_LANGUAGE=auto
TTS_GEMINI_TIMEOUT_SECONDS=30
TTS_RATE=175
TTS_VOLUME=1.0
TTS_SELECTED_VOICE=
TTS_STARTUP_GREETING=true

# Phase 4.2 hybrid voice input. UI settings override these defaults after save.
VOICE_SETTINGS_FILE=freshy_core/voice_settings.json
VOICE_RECOGNITION_ENGINE=auto
WHISPER_MODEL=base
VOICE_RESPONSE_SILENCE_SECONDS=3.0
VOICE_MODEL_DIR=freshy_core/models/vosk-model-small-en-in-0.4

# Fast natural speech start. Freshy synthesizes short speakable chunks instead
# of waiting for a long full reply.
TTS_FAST_START_ENABLED=true
TTS_PREPARE_DURING_SILENCE=true
TTS_FAST_CHUNK_CHARACTERS=260
TTS_FIRST_CHUNK_CHARACTERS=150
TTS_VOICE_STYLE=natural
TTS_FAILURE_BEHAVIOR=silent
TTS_FALLBACK_PROVIDER=none
TTS_HUMAN_VOICE_PROFILE=
TTS_STABLE_AUDIO_ENABLED=true
TTS_TRIM_BOUNDARY_SILENCE=true

# Optional consented human/cloned voice through XTTS.
# Recommended: run the isolated Python 3.11 server with start_xtts_server.bat.
XTTS_MODE=disabled
XTTS_SERVER_URL=http://127.0.0.1:8020
XTTS_SERVER_TOKEN=
XTTS_TIMEOUT_SECONDS=45
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_USE_GPU=true

# Phase 5 persistent memory. The SQLite database stays local and is ignored by Git.
MEMORY_ENABLED=true
# ask_before_saving | auto_safe | manual_only | disabled
MEMORY_MODE=ask_before_saving
MEMORY_DATABASE_PATH=freshy_core/data/freshy_memory.db
MEMORY_MAX_ITEMS=500
MEMORY_MAX_ITEM_CHARACTERS=2000
MEMORY_RECALL_LIMIT=6
MEMORY_RECALL_CHARACTERS=2500
MEMORY_PERSIST_CONVERSATIONS=true
MEMORY_CONVERSATION_RETENTION_DAYS=30
MEMORY_AUTO_PROFILE_DETECTION=true
# Node/mobile preview keeps its own server-side memory file; never expose it through VITE_*.
MEMORY_NODE_FILE_PATH=.freshy-data/mobile-memory.json

# Phase 6 real-time Live Voice Agent (Gemini Live API, preview).
# Standard mode keeps Whisper/Vosk + multi-provider routing. Live mode streams
# raw 16-bit PCM audio over one warm session for lower latency and true barge-in.
LIVE_VOICE_ENABLED=true
LIVE_CONVERSATION_MODE=standard
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
LIVE_AUTO_START=false
LIVE_SILENCE_DURATION_MS=700
LIVE_PREFIX_PADDING_MS=120
LIVE_MICROPHONE_CHUNK_MS=40
LIVE_OUTPUT_BUFFER_MS=80
LIVE_FALLBACK_MODE=standard
LIVE_SETTINGS_FILE=freshy_core/live_settings.json
